{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentinel Authenticator",
  "version": "0.1.0",
  "identifier": "com.sentinel.authenticator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sentinel Authenticator",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "alwaysOnTop": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#121216",
        "label": "main",
        "hidden": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null,
      "freezePrototype": false,
      "dangerousDisableAssetCspModification": false
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "title": "Sentinel",
      "tooltip": "Sentinel Authenticator"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 Sentinel",
    "category": "Utility",
    "shortDescription": "Local-first encrypted 2FA authenticator",
    "longDescription": "Sentinel Authenticator is a local-first, fully offline desktop two-factor authentication app for Windows. All secrets are encrypted with AES-256-GCM at rest and unlocked only with your master password.",
    "publisher": "Sentinel",
    "homepage": null,
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["en-US"],
        "displayLanguageSelector": false,
        "template": null,
        "headerImage": null,
        "sidebarImage": null,
        "license": null
      },
      "msi": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["en-US"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": false
  }
}
